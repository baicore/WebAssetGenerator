{
  "name": "webforge",
  "version": "0.1.0",
  "description": "Lightweight, config-driven CLI build tool for modern web projects.",
  "type": "module",
  "license": "MIT",
  "bin": { "webforge": "./bin/webforge.js" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["bin", "dist"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.js"
  },
  "dependencies": {
    "esbuild": "^0.25.0",
    "tinyglobby": "^0.2.10"
  },
  "peerDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@tailwindcss/cli": { "optional": true },
    "tailwindcss": { "optional": true }
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "@types/node": "^22.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0"
  }
}
